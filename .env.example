# Server
APP_NAME=MediNote Backend
# false en producciÃ³n; DEBUG=true estÃ¡ bien en desarrollo local
DEBUG=false
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# API
API_TIMEOUT_SEC=30
RATE_LIMIT_PER_MINUTE=60

# AI â€” set MOCK_AI=true to run without API keys
MOCK_AI=true
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
STT_PROVIDER=grok
STT_MODEL=grok-4-20-non-reasoning
AZURE_AI_STT_ENDPOINT=https://scia.services.ai.azure.com/openai/v1/
AZURE_API_KEY=

# Limits
MAX_AUDIO_MB=10
MAX_WS_CHUNKS=500
WS_TRANSCRIBE_ON_INTERVAL=false
WS_TRANSCRIBE_INTERVAL_SEC=2.0

