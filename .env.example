# Server
APP_NAME=MediNote Backend
DEBUG=false
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
DATABASE_URL=sqlite:///./medinote.db
USE_ALEMBIC=true
SEED_ON_STARTUP=true

# API
API_TIMEOUT_SEC=90
RATE_LIMIT_PER_MINUTE=60

# IA — Gemini (STT audio directo + chat/historial REST)
MOCK_AI=false
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Agente conversacional (Azure OpenAI + Groq STT)
AZURE_API_KEY=
AZURE_OPENAI_ENDPOINT=https://scia.cognitiveservices.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-5.3-chat
AZURE_OPENAI_API_VERSION=2024-12-01-preview
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

# Auth (JWT + Argon2)
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=480
AUTH_DISABLED=false

# SMTP — correo al confirmar historial
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=medinote@example.com
SMTP_USE_TLS=true

# Limits
MAX_AUDIO_MB=10
MAX_WS_CHUNKS=500
WS_TRANSCRIBE_ON_INTERVAL=false
WS_TRANSCRIBE_INTERVAL_SEC=2.0

# Storage
PDF_OUTPUT_DIR=pdfs
AUDIO_OUTPUT_DIR=audio
SIGNATURES_OUTPUT_DIR=signatures
LOGOS_OUTPUT_DIR=logos

# Microservicio PDF a Radicado (remoto)
RADICADO_SERVICE_URL=http://20.121.178.90:5437
RADICADO_TIMEOUT_SEC=180
RADICADO_SERVICE_TOKEN=

# Encabezado PDF incapacidad (formato Melanys)
EMPRESA_NIT=901240743
EMPRESA_RAZON_SOCIAL=CLINICA SAN IGNACIO
CLINICA_DIRECCION=Calle 76#6b-36 Barranquilla - Atlantico
CLINICA_TELEFONO=(605) 3852438
CLINICA_NIT=800025755-2
CLINICA_REPS=0800100328
